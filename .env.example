# Ejemplo de nombres de variables. NO uses estas cadenas de ejemplo como credenciales.
# En Windows, .\iniciar.ps1 genera claves de infraestructura aleatorias.
# Las tres cuentas DEMO usan scamusica123 solamente para pruebas en localhost.
# No subas el archivo .env real a GitHub.
DB_USER=scamusica
DB_PASSWORD=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_OTRO_SECRETO_ALEATORIO
JWT_SECRET=REEMPLAZAR_CON_64_CARACTERES_HEX_ALEATORIOS
INTERNAL_KEY=REEMPLAZAR_CON_OTROS_64_CARACTERES_HEX_ALEATORIOS
DEMO_ADMIN_PASSWORD=REEMPLAZAR_CON_CLAVE_ADMIN_DE_AL_MENOS_8_CARACTERES
DEMO_VENDEDOR_PASSWORD=REEMPLAZAR_CON_CLAVE_VENDEDOR_DE_AL_MENOS_8_CARACTERES
DEMO_CLIENTE_PASSWORD=REEMPLAZAR_CON_CLAVE_CLIENTE_DE_AL_MENOS_8_CARACTERES
